{
  "expo": {
    "name": "Calen",
    "slug": "household-calendar",
    "scheme": "householdcalendar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.householdcalendar.mobile",
      "associatedDomains": [
        "webcredentials:householdcalendar.com"
      ],
      "infoPlist": {
        "CFBundleDisplayName": "Calen",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "LSApplicationQueriesSchemes": [
          "message",
          "googlegmail",
          "ms-outlook",
          "readdle-spark",
          "ymail",
          "protonmail",
          "fastmail",
          "comgooglemaps"
        ],
        "NSCameraUsageDescription": "Take photos of items, receipts, recipes, and booking confirmations to add them automatically.",
        "NSPhotoLibraryUsageDescription": "Attach photos of items, receipts, and confirmations from your library.",
        "NSContactsUsageDescription": "Import family and friends from your contacts so the assistant can suggest activities and remember birthdays.",
        "NSLocationWhenInUseUsageDescription": "Fill in your home address automatically when you tap “Use my current location”. Your location is never tracked in the background.",
        "NSFaceIDUsageDescription": "Use Face ID to sign in and unlock your end-to-end-encrypted data on this device."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeContacts",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "app.householdcalendar.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F3F6FA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#4F9DF5"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos of items, receipts, and confirmations.",
          "cameraPermission": "Take photos of items, receipts, recipes, and booking confirmations to add them automatically.",
          "microphonePermission": "Let Calen hear you when you talk to the assistant."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4F9DF5"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-contacts",
        {
          "contactsPermission": "Import family and friends from your contacts so the assistant can suggest activities and remember birthdays."
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Let Calen hear you when you talk to the assistant.",
          "speechRecognitionPermission": "Convert your speech to text on-device so you can talk to Calen. Your voice is transcribed on your device and isn’t sent to Apple.",
          "androidSpeechServicePackages": []
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:3001",
      "eas": {
        "projectId": "aca35cff-ab55-4811-9ad1-cf36b40c7ea8"
      }
    },
    "owner": "polk-tech"
  }
}
