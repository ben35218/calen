PORT=3001
MONGODB_URI=mongodb://localhost:27017/household-calendar
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# File storage
UPLOAD_DIR=./uploads

# Outbound email SMTP (services/mailer.js). Leave blank to log emails instead
# of sending. Production uses a Migadu mailbox on householdcalendar.com.
SMTP_HOST=smtp.migadu.com
SMTP_PORT=465
SMTP_USER=no-reply@householdcalendar.com
SMTP_PASS=your-mailbox-password
MAIL_FROM=Calen <no-reply@householdcalendar.com>

# Support mailbox (services/supportMail.js) — lets the admin web app read and
# reply to support@householdcalendar.com over IMAP/SMTP. Migadu authenticates
# per-mailbox, so this needs the support@ mailbox's own credentials (not the
# no-reply@ ones above). Leave blank to hide the support inbox in admin.
SUPPORT_EMAIL_USER=support@householdcalendar.com
SUPPORT_EMAIL_PASS=your-support-mailbox-password
# Defaults: imap.migadu.com:993 / smtp.migadu.com:465 — only set to override.
#SUPPORT_IMAP_HOST=
#SUPPORT_IMAP_PORT=
#SUPPORT_SMTP_HOST=
#SUPPORT_SMTP_PORT=
# App-download links used in email CTAs. Leave store URLs blank until the
# listings exist; emails then link to WEB_URL instead.
APP_STORE_URL=
PLAY_STORE_URL=
WEB_URL=https://householdcalendar.com

# App URL (used in email/push deep-links)
APP_URL=http://localhost:5174

# Web Push (browser push notifications). Generate a key pair once with:
#   npx web-push generate-vapid-keys
# Leave blank to disable push (email + in-app notifications still work).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Google Places API — location autocomplete and phone lookup in calendar events
# Enable "Places API" in Google Cloud Console and restrict the key to your server IP
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# RevenueCat — in-app purchases (app unlock, credit packs, the Calen AI plan,
# add-ons). The shared secret configured on the RevenueCat webhook
# (Authorization header) → POST /api/billing/webhook. REQUIRED in production:
# without it every purchase event is rejected 401 and paid entitlements
# silently never land.
REVENUECAT_WEBHOOK_SECRET=change-me-to-a-long-random-string

# OPTIONAL: a RevenueCat secret API key (dashboard -> API keys, "sk_" key).
# When set, account deletion best-effort-purges the RevenueCat subscriber
# (DELETE /v1/subscribers/{id}) -- data minimization to match the full-wipe
# promise. It does NOT cancel store subscriptions (only Apple can). Unset ->
# the purge is skipped silently and deletion works exactly as before.
# REVENUECAT_SECRET_API_KEY=

# Vapi — AI phone calling (calendar appointment cancellations/reschedules)
# 1. Sign up at https://vapi.ai and get your API key from the dashboard
# 2. Add your Anthropic API key in Vapi dashboard → Providers so the voice agent can use Claude
# 3. Buy a phone number in Vapi dashboard → Phone Numbers, then paste its ID below
VAPI_API_KEY=your-vapi-api-key
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id
# Do-not-call: recipients can opt out of automated calls (spec: ai-assistant.md).
# HMAC key for the suppression list (keep stable — rotating it orphans existing
# entries). Required in production; falls back to JWT_SECRET elsewhere.
DNC_HASH_SECRET=change-me-to-a-long-random-string
# Shared secret Vapi echoes in X-Vapi-Secret when the in-call agent captures an
# opt-out via the record_do_not_call tool → POST /api/calls/vapi/webhook.
VAPI_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Public base URL of this server (e.g. https://api.example.com). Used to build
# the Vapi opt-out webhook URL. On Render, RENDER_EXTERNAL_URL is used if unset.
# When neither is set, real-time opt-out capture is skipped and the post-call
# analysis backstop handles opt-outs instead.
PUBLIC_BASE_URL=
